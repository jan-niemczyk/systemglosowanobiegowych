// iGŁOSOWANIA - System Głosowań Obiegowych
// Schemat bazy danych zgodny z "Koncepcją przebudowy" (v1.0, sierpień 2026).
// Rdzeń: sprawa obiegowa (Case) zamiast posiedzenia; brak elementów czasu rzeczywistego.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────

enum Role {
  OPERATOR
  PARTICIPANT
}

/// Etapy cyklu życia sprawy obiegowej (sekcja 7 koncepcji).
enum CaseStatus {
  DRAFT // projekt - w przygotowaniu przez operatora
  OPEN // otwarta - trwa oddawanie głosów
  CLOSED // zamknięta - głosowanie zakończone
  RESULTS_PUBLISHED // wyniki opublikowane i dostępne uczestnikom
  CANCELLED // anulowana przed otwarciem lub w trakcie
}

/// Tryb zakończenia sprawy (sekcja 7.1).
enum CloseMode {
  MANUAL // operator zamyka ręcznie po ocenie
  ALL_VOTED // automatycznie, gdy wszyscy uprawnieni oddadzą głos na wszystkich pozycjach
  DEADLINE // automatycznie z upływem terminu (obsługiwane przez harmonogram)
  DEADLINE_OR_ALL_VOTED // automatycznie z upływem terminu LUB po oddaniu wszystkich głosów - co nastąpi pierwsze, jak DEADLINE
}

/// Sposób publikacji wyników (sekcja 7.3).
enum ResultsVisibility {
  AUTO_ON_CLOSE // wyniki widoczne od razu po zamknięciu
  MANUAL // operator publikuje wyniki ręcznie po weryfikacji
}

enum VoteType {
  STANDARD // za / przeciw / wstrzymuję się
  PACKAGE // pakietowe - wiele pozycji, na każdą osobno za/przeciw/wstrzym.
  LIST // na kandydatów / listę - wybór dopuszczonych opcji
}

enum VoteVisibility {
  OPEN // jawne - z imienną historią
  SECRET // tajne - bez powiązania osoby z wyborem
}

enum ItemStatus {
  PENDING // przed otwarciem sprawy
  OPEN // trwa głosowanie nad pozycją
  CLOSED // zamknięta wraz ze sprawą
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

enum DocumentKind {
  DRAFT // projekt uchwały/decyzji - publikowany przed otwarciem
  ATTACHMENT // załącznik pomocniczy - publikowany przed otwarciem
  RESULT // dokument wynikowy - publikowany po zamknięciu
}

enum AuditAction {
  CASE_CREATED
  CASE_UPDATED
  CASE_OPENED
  CASE_CLOSED
  CASE_CANCELLED
  CASE_DELETED
  RESULTS_PUBLISHED
  RESULTS_HIDDEN
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  PARTICIPANT_RIGHT_CHANGED
  SETTINGS_CHANGED
  BODY_CREATED
  BODY_UPDATED
  BODY_DELETED
}

// ─────────────────────────────────────────────────────────────────
//  UŻYTKOWNICY I USTAWIENIA
// ─────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role     @default(PARTICIPANT)
  /// Funkcja osoby (np. "Przewodniczący", "Wiceprzewodnicząca") - do wydruków.
  functionTitle String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bodyMemberships    BodyMembership[]
  caseParticipations CaseParticipant[]
  operatedCases      Case[]            @relation("CaseOperator")
  ballots            Ballot[]
  auditLogs          AuditLog[]
  uploadedDocuments  CaseDocument[]

  @@index([role])
  @@index([active])
}

/// Globalne ustawienia organizacji (jeden rekord).
model Settings {
  id                       String            @id @default("singleton")
  organizationName         String            @default("Organizacja")
  logoUrl                  String?
  defaultVoteVisibility    VoteVisibility    @default(OPEN)
  defaultCloseMode         CloseMode         @default(MANUAL)
  defaultResultsVisibility ResultsVisibility @default(MANUAL)
  defaultAllowVoteChange   Boolean           @default(true)
  /// Limit wielkości pojedynczego pliku dokumentu (MB).
  maxDocumentSizeMB        Int               @default(20)
  /// Dopuszczalne rozszerzenia plików dokumentów (bez kropki, małe litery).
  allowedDocumentTypes     String[]          @default(["pdf", "doc", "docx", "odt", "jpg", "jpeg", "png"])
  updatedAt                DateTime          @updatedAt
}

// ─────────────────────────────────────────────────────────────────
//  ORGANY I SKŁADY (sekcja 6.1, 12.1)
// ─────────────────────────────────────────────────────────────────

/// Organ lub zespół (np. Rada, Komisja) - rejestr z gotowym składem członkowskim,
/// wykorzystywanym do szybkiego budowania składu nowej sprawy.
model Body {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members BodyMembership[]
  cases   Case[]

  @@index([name])
}

model BodyMembership {
  id             String   @id @default(cuid())
  bodyId         String
  body           Body     @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasVotingRight Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([bodyId, userId])
  @@index([bodyId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────
//  SPRAWA OBIEGOWA (sekcje 5, 7, 12.1)
// ─────────────────────────────────────────────────────────────────

model Case {
  id          String  @id @default(cuid())
  /// Opcjonalny numer sprawy, np. "12/2026".
  number      String?
  title       String
  description String?
  bodyId      String?
  body        Body?   @relation(fields: [bodyId], references: [id], onDelete: SetNull)
  operatorId  String?
  operator    User?   @relation("CaseOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  status CaseStatus @default(DRAFT)

  // ── konfiguracja (osobno dla każdej sprawy - sekcja 3) ──
  closeMode         CloseMode         @default(MANUAL)
  resultsVisibility ResultsVisibility @default(MANUAL)
  allowVoteChange   Boolean           @default(true)

  // ── terminy ──
  openedAt           DateTime?
  deadlineAt         DateTime? // termin końcowy (dla closeMode = DEADLINE)
  closedAt           DateTime?
  resultsPublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants CaseParticipant[]
  items        VotingItem[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([deadlineAt])
}

/// Migawka osoby uprawnionej w konkretnej sprawie - niezależna od późniejszych
/// zmian składu organu (sekcja 5.1, 12.1). Skład jest wspólny dla wszystkich
/// pozycji głosowania w tej sprawie.
model CaseParticipant {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasVotingRight Boolean  @default(true)
  // snapshot personaliów w chwili dodania - do historycznych wydruków
  firstName      String
  lastName       String
  addedAt        DateTime @default(now())

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────
//  POZYCJE GŁOSOWANIA (sekcje 5.2, 5.3, 5.4)
// ─────────────────────────────────────────────────────────────────

model VotingItem {
  id          String  @id @default(cuid())
  caseId      String
  case        Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?

  type       VoteType       @default(STANDARD)
  visibility VoteVisibility @default(OPEN)

  // dla głosowania na listę:
  minSelections Int?
  maxSelections Int?

  status    ItemStatus @default(PENDING)
  createdAt DateTime   @default(now())

  // wyniki (snapshot po zamknięciu sprawy) - dla szybkiego dostępu/raportów
  resultEligibleCount Int?
  resultCastCount     Int?
  resultYes           Int?
  resultNo            Int?
  resultAbstain       Int?

  // ── TAJNE: tylko zbiorcze liczniki + anonimowe znaczniki oddania głosu ──
  secretYes     Int @default(0)
  secretNo      Int @default(0)
  secretAbstain Int @default(0)

  options       VoteOption[]
  ballots       Ballot[]
  secretMarkers SecretBallotMarker[]
  documents     CaseDocument[]

  @@unique([caseId, order])
  @@index([caseId, status])
}

model VoteOption {
  id            String     @id @default(cuid())
  itemId        String
  item          VotingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order         Int
  label         String // nazwisko kandydata / nazwa pozycji pakietu
  description   String?
  // snapshot wyniku po zamknięciu (jawne)
  resultYes     Int?
  resultNo      Int?
  resultAbstain Int?
  // anonimowe liczniki (tajne)
  secretYes     Int        @default(0)
  secretNo      Int        @default(0)
  secretAbstain Int        @default(0)

  ballotSelections BallotSelection[]

  @@unique([itemId, order])
}

model Ballot {
  id     String     @id @default(cuid())
  itemId String
  item   VotingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // null dla głosów tajnych (nigdy nie zapisujemy wyboru z powiązaniem do osoby)
  userId String?
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  choice     VoteChoice? // STANDARD
  selections BallotSelection[] // PACKAGE / LIST

  // snapshot personaliów w chwili oddania głosu
  voterFirstName String?
  voterLastName  String?

  castAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, userId])
  @@index([itemId])
}

model BallotSelection {
  id       String      @id @default(cuid())
  ballotId String
  ballot   Ballot      @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  optionId String
  option   VoteOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// Pakiet: głos oddany na tę pozycję. Lista: pozostaje null (zaznaczenie = ZA).
  choice   VoteChoice?

  @@unique([ballotId, optionId])
}

/// Anonimowy znacznik: dana osoba oddała głos w danej TAJNEJ pozycji (bez wyboru).
model SecretBallotMarker {
  id     String     @id @default(cuid())
  itemId String
  item   VotingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  castAt DateTime   @default(now())

  @@unique([itemId, userId])
  @@index([itemId])
}

// ─────────────────────────────────────────────────────────────────
//  DOKUMENTY (sekcja 8)
// ─────────────────────────────────────────────────────────────────

/// Plik przypięty do konkretnej pozycji głosowania (nie do sprawy jako całości),
/// przechowywany poza katalogiem publicznym, udostępniany wyłącznie po sprawdzeniu
/// uprawnień (operator lub uczestnik sprawy, do której należy pozycja).
model CaseDocument {
  id           String       @id @default(cuid())
  itemId       String
  item         VotingItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  fileName     String // nazwa wyświetlana
  storedName   String       @unique // nazwa pliku na dysku (losowa)
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime     @default(now())

  @@index([itemId, kind])
}

// ─────────────────────────────────────────────────────────────────
//  REJESTR CZYNNOŚCI (sekcja 10)
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  caseId      String?
  case        Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  description String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([caseId, createdAt])
  @@index([action])
}
