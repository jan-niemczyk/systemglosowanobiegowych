# --- baza danych ---
POSTGRES_DB=sgo
POSTGRES_USER=sgo
POSTGRES_PASSWORD=zmien_to_haslo_w_prod
DATABASE_URL=postgresql://sgo:zmien_to_haslo_w_prod@localhost:5432/sgo

# --- Auth.js ---
# wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET=zmien_to_w_produkcji_dlugi_losowy_ciag_minimum_32_znaki
NEXTAUTH_URL=http://localhost:3000

# --- pierwsze uruchomienie ---
# ustaw na true tylko przy pierwszym deploju, żeby utworzyć ustawienia + konto operatora
INIT_SEED=false
SEED_OPERATOR_EMAIL=operator@sgo.local
SEED_OPERATOR_PASSWORD=

# --- harmonogram automatycznego zamykania spraw (sekcja 12) ---
# co ile sekund harmonogram sprawdza sprawy z upłynionym terminem
SCHEDULER_INTERVAL_SECONDS=60
